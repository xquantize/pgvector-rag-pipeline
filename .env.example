# Copy to .env and fill in. .env is gitignored.
# No paid OpenAI/Anthropic keys required — Ollama (local) is the default.

# --- Providers (free / local) ---
# Embeddings: ollama | huggingface
EMBEDDING_PROVIDER=ollama
# Chat / judge: ollama (talks to a local Ollama server)
LLM_PROVIDER=ollama

# Ollama (https://ollama.com) — install models first:
#   ollama pull nomic-embed-text
#   ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2

# Hugging Face local embeddings (optional; pip install -e ".[huggingface]")
# Must produce vectors of length EMBEDDING_DIM (nomic / bge-base / mpnet → 768).
HF_EMBED_MODEL=BAAI/bge-base-en-v1.5
# HF_TOKEN=   # only needed for gated models or the Inference API (not required for local)

# Postgres (matches docker-compose.yml)
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=ragdb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Pipeline knobs (tune these during eval)
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5
# Must match VECTOR(n) in scripts/init_db.sql and your embedding model.
EMBEDDING_DIM=768
